---
import { navItems } from '../data/nav';
import { profile } from '../data/profile';

type Item = { label: string; hint: string; group: string; action: string; value: string };

const items: Item[] = [
  ...navItems.map((n) => ({ label: n.title, hint: `#${n.id}`, group: 'Go to', action: 'goto', value: n.id })),
  { label: 'Copy email address', hint: profile.email, group: 'Actions', action: 'copy', value: profile.email },
  { label: 'Send an email', hint: 'mailto', group: 'Actions', action: 'open', value: `mailto:${profile.email}` },
  { label: 'Download CV (PDF)', hint: 'pdf', group: 'Actions', action: 'download', value: profile.cvPath },
  { label: 'Toggle light / dark theme', hint: 'theme', group: 'Actions', action: 'theme', value: '' },
  { label: 'Open LinkedIn', hint: 'linkedin.com/in/samak97', group: 'Links', action: 'open', value: profile.links.linkedin },
  { label: 'Open GitHub', hint: 'github.com/samak97', group: 'Links', action: 'open', value: profile.links.github },
  { label: 'Open X', hint: profile.xHandle, group: 'Links', action: 'open', value: profile.links.x },
];
---

<dialog class="palette" aria-label="Command palette">
  <div class="pal-box">
    <div class="pal-input-row">
      <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"
        ><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" d="m20 20-4.2-4.2M10.8 17.6a6.8 6.8 0 1 0 0-13.6 6.8 6.8 0 0 0 0 13.6Z"
        ></path></svg
      >
      <input
        class="pal-input"
        type="text"
        placeholder="Jump to a section or run an action…"
        aria-label="Search"
        aria-controls="pal-list"
        autocomplete="off"
        spellcheck="false"
      />
      <kbd>Esc</kbd>
    </div>
    <ul class="pal-list" id="pal-list" role="listbox">
      {
        items.map((it, i) => (
          <li
            role="option"
            aria-selected={i === 0 ? 'true' : 'false'}
            data-action={it.action}
            data-value={it.value}
            data-search={`${it.label} ${it.hint} ${it.group}`.toLowerCase()}
          >
            <span class="pal-group mono">{it.group}</span>
            <span class="pal-label">{it.label}</span>
            <span class="pal-hint mono">{it.hint}</span>
          </li>
        ))
      }
    </ul>
    <p class="pal-empty" hidden>No results. Try “arcade” or “email”.</p>
    <div class="pal-foot mono"><span><kbd>↑</kbd><kbd>↓</kbd> move</span><span><kbd>Enter</kbd> select</span></div>
  </div>
</dialog>

<div class="toast mono" role="status" aria-live="polite"></div>

<style>
  .palette {
    width: min(620px, calc(100vw - 32px));
    max-height: min(560px, calc(100svh - 120px));
    margin: 12vh auto auto;
    padding: 0;
    border: 1px solid var(--border-strong);
    border-radius: 16px;
    background: var(--surface);
    color: var(--text);
    box-shadow: 0 30px 80px -20px rgba(0, 0, 0, 0.7);
    overflow: hidden;
  }
  .palette::backdrop {
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(4px);
  }
  .palette[open] {
    animation: pop 0.25s var(--ease-out);
  }
  @keyframes pop {
    from {
      opacity: 0;
      transform: translateY(-10px) scale(0.98);
    }
  }
  .pal-box {
    display: flex;
    flex-direction: column;
    max-height: inherit;
  }
  .pal-input-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    border-bottom: 1px solid var(--border);
    color: var(--muted);
  }
  .pal-input {
    flex: 1;
    min-width: 0;
    background: none;
    border: 0;
    outline: none;
    color: var(--text);
    font: inherit;
    font-size: 16px;
  }
  .pal-list {
    list-style: none;
    margin: 0;
    padding: 8px;
    overflow-y: auto;
  }
  .pal-list li {
    display: grid;
    grid-template-columns: 64px 1fr auto;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    border-radius: 10px;
    cursor: pointer;
  }
  .pal-list li[hidden] {
    display: none;
  }
  .pal-list li[aria-selected='true'] {
    background: var(--surface-2);
    box-shadow: inset 2px 0 0 var(--accent);
  }
  .pal-group {
    font-size: 0.68rem;
    color: var(--faint);
    text-transform: uppercase;
  }
  .pal-hint {
    font-size: 0.72rem;
    color: var(--faint);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 180px;
  }
  .pal-empty {
    padding: 24px;
    text-align: center;
    color: var(--muted);
  }
  .pal-foot {
    display: flex;
    gap: 16px;
    padding: 10px 16px;
    border-top: 1px solid var(--border);
    font-size: 0.72rem;
    color: var(--faint);
  }
  .pal-foot kbd {
    margin-right: 3px;
  }
  @media (max-width: 520px) {
    .pal-hint {
      display: none;
    }
    .pal-list li {
      grid-template-columns: 54px 1fr;
    }
    .pal-foot {
      display: none;
    }
  }

  .toast {
    position: fixed;
    left: 50%;
    bottom: calc(24px + env(safe-area-inset-bottom));
    z-index: 90;
    padding: 10px 18px;
    border-radius: 999px;
    font-size: 0.85rem;
    background: var(--text);
    color: var(--bg);
    transform: translate(-50%, 140%);
    opacity: 0;
    transition: transform 0.4s var(--ease-out), opacity 0.4s;
    pointer-events: none;
  }
  .toast.show {
    transform: translate(-50%, 0);
    opacity: 1;
  }
</style>
