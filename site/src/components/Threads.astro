---
import Icon from './Icon.astro';
import { posts } from '../data/showcase';
import { profile } from '../data/profile';
---

<section id="threads" class="section" aria-labelledby="threads-title">
  <div class="section-head" data-reveal>
    <p class="crumb">docs / reference / <b>threads</b></p>
    <h2 id="threads-title" class="section-title">Threads</h2>
    <p class="section-lead">Side projects, experiments, and thoughts on engineering, from X.</p>
  </div>

  {
    posts.length > 0 && (
      <div class="posts">
        {posts.map((p) => (
          <a class:list={['post card spotlight', `post-${p.kind}`]} href={p.url} target="_blank" rel="noopener" data-reveal>
            {p.image && (
              <div class="media">
                <img src={p.image} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
                {p.video && (
                  <span class="play" aria-hidden="true">
                    <Icon name="play" size={22} />
                  </span>
                )}
                {p.kind === 'article' && <span class="tag mono">Article</span>}
              </div>
            )}
            <div class="post-body">
              <header class="post-head">
                <img class="avatar" src="/me-320.webp" alt="" width="36" height="36" loading="lazy" decoding="async" />
                <span class="who">
                  <strong>{profile.name}</strong>
                  <span class="handle mono">
                    {profile.xHandle} · <time>{p.date}</time>
                  </span>
                </span>
                <Icon name="x" size={16} class="post-x" />
              </header>
              {p.title && <h3 class="post-title">{p.title}</h3>}
              <p class="post-text">{p.text}</p>
              <span class="post-cta mono">
                {p.kind === 'article' ? 'Read the article' : p.video ? 'Watch on X' : 'View on X'} <Icon name="external" size={14} />
              </span>
            </div>
          </a>
        ))}
      </div>
    )
  }

  <a class="follow card" href={profile.links.x} target="_blank" rel="noopener me" data-reveal>
    <span class="follow-icon"><Icon name="x" size={22} /></span>
    <span class="follow-copy">
      <strong>Follow {profile.xHandle}</strong>
      <span>More threads live on X. Come say hi.</span>
    </span>
    <Icon name="arrow" class="follow-arrow" />
  </a>
</section>

<style>
  .posts {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
    margin-bottom: 18px;
  }
  .post {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: border-color 0.3s, transform 0.4s var(--ease-out), box-shadow 0.3s;
  }
  .post:hover {
    border-color: var(--border-strong);
    transform: translateY(-4px);
    box-shadow: var(--shadow);
  }
  .media {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--surface-2);
  }
  .post-article .media {
    aspect-ratio: 2.5 / 1;
  }
  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-out);
  }
  .post:hover .media img {
    transform: scale(1.04);
  }
  .play {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 60px;
    height: 60px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    color: #fff;
    background: rgba(8, 10, 14, 0.6);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border: 1px solid rgba(255, 255, 255, 0.25);
    transition: transform 0.3s var(--ease-out), background-color 0.3s;
  }
  .post:hover .play {
    transform: scale(1.1);
    background: var(--accent);
    color: var(--accent-ink);
  }
  .tag {
    position: absolute;
    top: 12px;
    left: 12px;
    padding: 3px 10px;
    border-radius: 999px;
    font-size: 0.7rem;
    color: var(--accent-ink);
    background: var(--accent);
  }
  .post-body {
    display: grid;
    gap: 12px;
    padding: 18px 20px 20px;
  }
  .post-head {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    object-fit: cover;
  }
  .who {
    display: grid;
    flex: 1;
    line-height: 1.3;
    font-size: 0.9rem;
  }
  .handle {
    font-size: 0.74rem;
    color: var(--muted);
  }
  .post-head :global(.post-x) {
    color: var(--muted);
  }
  .post-title {
    font-size: clamp(1.15rem, 2.4vw, 1.4rem);
  }
  .post-text {
    white-space: pre-line;
    color: var(--muted);
    font-size: 0.95rem;
  }
  .post-post .post-text {
    color: var(--text);
  }
  .post-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8rem;
    color: var(--accent);
  }

  .follow {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 20px 22px;
    transition: border-color 0.3s, transform 0.3s var(--ease-out);
  }
  .follow:hover {
    border-color: var(--text);
    transform: translateY(-2px);
  }
  .follow-icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    flex: 0 0 auto;
    border-radius: 12px;
    background: var(--text);
    color: var(--bg);
  }
  .follow-copy {
    display: grid;
    flex: 1;
  }
  .follow-copy span {
    font-size: 0.9rem;
    color: var(--muted);
  }
  .follow :global(.follow-arrow) {
    color: var(--muted);
    transition: transform 0.3s var(--ease-out);
  }
  .follow:hover :global(.follow-arrow) {
    transform: translateX(4px);
    color: var(--text);
  }
  @media (min-width: 900px) {
    .posts {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    }
  }
</style>
