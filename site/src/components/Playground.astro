---
const steps = [10_000, 50_000, 100_000, 250_000, 500_000, 1_000_000];
---

<section id="playground" class="section" aria-labelledby="pg-title">
  <div class="section-head" data-reveal>
    <p class="crumb">docs / reference / <b>gpu-playground</b></p>
    <h2 id="pg-title" class="section-title">GPU playground</h2>
    <p class="section-lead">
      The million-marker trick, live in your browser. Switch between drawing every marker one by one on the CPU and
      drawing them all at once on the GPU, then watch the frame rate.
    </p>
  </div>

  <div class="pg card" data-playground data-steps={JSON.stringify(steps)} data-reveal>
    <div class="pg-stage">
      <canvas class="pg-gl" aria-label="Animated map of colored markers rendered with WebGL"></canvas>
      <canvas class="pg-2d" aria-hidden="true"></canvas>
      <div class="hud mono" aria-live="polite">
        <span><b data-hud-fps>--</b> fps</span>
        <span><b data-hud-count>100,000</b> markers</span>
        <span class="hud-mode" data-hud-mode>GPU · 1 draw call</span>
      </div>
      <p class="pg-hint mono">drag to pan · pinch or ctrl + scroll to zoom · double-click to reset</p>
      <p class="pg-fallback" hidden>Your browser has WebGL turned off, so the live demo can't run here.</p>
    </div>

    <div class="pg-controls">
      <div class="seg" role="radiogroup" aria-label="Rendering mode">
        <button role="radio" aria-checked="true" data-mode="gpu">GPU · all at once</button>
        <button role="radio" aria-checked="false" data-mode="cpu">CPU · one by one</button>
      </div>

      <label class="slider">
        <span class="mono">markers</span>
        <input type="range" min="0" max={steps.length - 1} step="1" value="2" data-count-input aria-valuetext="100,000 markers" />
        <span class="ticks mono" aria-hidden="true">
          {steps.map((s) => <span>{s >= 1_000_000 ? '1M' : `${s / 1000}K`}</span>)}
        </span>
      </label>

      <p class="pg-note" data-cpu-note hidden>CPU mode is capped at 100K markers so your device stays responsive. That's the whole point.</p>
    </div>
  </div>
</section>

<style>
  .pg {
    overflow: hidden;
  }
  .pg-stage {
    position: relative;
    aspect-ratio: 16 / 9;
    min-height: 280px;
    max-height: 70vh;
    width: 100%;
    background: radial-gradient(ellipse at center, #0f1a24, #070a0e);
    /* Vertical swipes still scroll the page on phones; horizontal drags and pinches go to the map. */
    touch-action: pan-y;
    cursor: grab;
  }
  .pg-stage:active {
    cursor: grabbing;
  }
  .pg-gl,
  .pg-2d {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .pg-2d {
    display: none;
  }
  .hud {
    position: absolute;
    top: 12px;
    left: 12px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 0.74rem;
    color: #b8c2d3;
  }
  .hud span {
    padding: 4px 10px;
    border-radius: 999px;
    background: rgba(5, 8, 12, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(6px);
  }
  .hud b {
    color: #fff;
  }
  .hud-mode {
    color: #5eead4;
  }
  .pg-hint {
    position: absolute;
    bottom: 10px;
    right: 12px;
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.45);
  }
  .pg-fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 24px;
    text-align: center;
    color: #b8c2d3;
  }
  .pg-fallback[hidden] {
    display: none;
  }

  .pg-controls {
    display: grid;
    gap: 18px;
    padding: 18px clamp(16px, 3vw, 24px) 22px;
    border-top: 1px solid var(--border);
  }
  .seg {
    display: inline-grid;
    grid-template-columns: 1fr 1fr;
    padding: 4px;
    border-radius: 999px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    width: fit-content;
    max-width: 100%;
  }
  .seg button {
    min-height: 38px;
    padding: 0 16px;
    border-radius: 999px;
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--muted);
    transition: background-color 0.25s, color 0.25s;
  }
  .seg button[aria-checked='true'] {
    background: var(--accent);
    color: var(--accent-ink);
  }
  .seg button[data-mode='cpu'][aria-checked='true'] {
    background: var(--c-cpp);
    color: #1a0d03;
  }
  .slider {
    display: grid;
    gap: 6px;
  }
  .slider > span:first-child {
    font-size: 0.75rem;
    color: var(--faint);
  }
  input[type='range'] {
    width: 100%;
    accent-color: var(--accent);
    height: 28px;
  }
  .ticks {
    display: flex;
    justify-content: space-between;
    font-size: 0.68rem;
    color: var(--faint);
  }
  .pg-note {
    font-size: 0.85rem;
    color: var(--c-cpp);
  }
</style>
